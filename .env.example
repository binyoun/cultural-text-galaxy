# Optional. Leave unset for local dev (in-memory + local /uploads folder,
# exactly the original behavior). Set both on Render for the online
# workshop so entries and images survive a restart or redeploy.

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Upload cap (matches the 50 TouchDesigner slots) and the token that
# protects POST /api/reset. Leave ADMIN_TOKEN unset to disable reset.
MAX_ENTRIES=50
ADMIN_TOKEN=
